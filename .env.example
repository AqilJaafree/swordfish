# --- swap scripts ---
# src/swap-v3.mjs (npm run quote:v3 / swap:v3): Uniswap V3 SwapRouter02, no API key needed
# src/swap.mjs    (npm run quote / swap):       DODO route API, needs DODO_API_KEY
DODO_API_KEY=
# Signs real swaps (swap / swap:v3). Use a dedicated wallet with small balances.
PRIVATE_KEY=0x

# --- API server (src/server.mjs) ---
PORT=8787
# HSK_RPC_URL=https://mainnet.hsk.xyz
# PRICE_CACHE_MS=15000
# MIN_LIQUIDITY_USD=10

# Candles for TA: geckoterminal (history, HyperIndex pools only) | sampler (real-time on-chain, builds up while running)
CANDLE_SOURCE=sampler
SAMPLER_ASSETS=hsk,weth
SAMPLER_INTERVAL_SEC=15

# true = HashKey pools only: no Yahoo prices/candles (stock tokens become untradable; they have no liquidity)
# ONCHAIN_ONLY=false

# Technical analysis
TA_ENABLED=true
# Built-in: sma,ema,rsi,macd,bbands. Paths load custom plugins, e.g. ./plugins/vwap.mjs
TA_INDICATORS=sma,ema,rsi,macd,bbands
# Per-indicator params: TA_<NAME>_<PARAM>
# TA_RSI_PERIOD=14
# TA_MACD_FAST=12
# TA_BBANDS_MULT=2

# Paper trading (fills use live pool quotes: real fees + price impact)
PAPER_ENABLED=true
PAPER_START_USDT=1000
# PAPER_STATE_FILE=data/paper-state.json
# Orders whose price impact exceeds this are rejected (override per order with "maxImpactPct")
PAPER_MAX_IMPACT_PCT=5

# Auto-trading: leave empty for manual orders only.
# Built-in: rsi-reversion. Or a path to your own strategy module.
PAPER_STRATEGY=
PAPER_ASSETS=hsk,weth
PAPER_TIMEFRAME=5m
PAPER_INTERVAL_SEC=60
# V3 pools (Oct 2026): HSK ~$870k, WBTC ~$100k, WETH ~$96k; ≈0.6-0.7% round trip at $20
PAPER_TRADE_USD=5
# Strategy params: PAPER_STRATEGY_<PARAM>
# PAPER_STRATEGY_BUY_BELOW=30
# PAPER_STRATEGY_SELL_ABOVE=70
# PAPER_STRATEGY_MAX_POSITION_USD=50

# --- multi-user bots, Telegram and web dashboard ---
# BOTS_ENABLED=true runs the bot engine, the Telegram bot and the dashboard at WEB_URL.
BOTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Only these Telegram usernames or numeric IDs can use the bot (empty = anyone).
TELEGRAM_ALLOWED_USERS=
# Encrypts custodial wallet keys (openssl rand -hex 32). Back it up: losing it loses every wallet.
MASTER_KEY=
# WEB_URL=http://localhost:8787
# DB_FILE=data/swordfish.db
# BOTS_PAPER_START_USDT=1000
# BOTS_MAX_PER_USER=5
# BOTS_MAX_CLAUDE_PER_USER=2
# BOTS_MIN_INTERVAL_SEC=60
# Live trading limits (per bot; bots can only be stricter)
# LIVE_MAX_TRADE_USD=50
# LIVE_MAX_BUDGET_USD=500
# LIVE_MAX_IMPACT_PCT=1
# LIVE_DAILY_LOSS_PCT=10
# LIVE_MIN_GAS_HSK=0.5
# Claude strategy
ANTHROPIC_API_KEY=
